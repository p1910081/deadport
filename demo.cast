[15.839, "o", "\u001b[7m# (attendre 1 seconde après le démarrage de l'enregistrement)\u001b[27m\r\r\n\u001b[7mdeadport 3000\u001b[27m\u001b[K\r\r\n\u001b[7m# (la prompt apparaît, tape \"y\" et Enter)\u001b[27m\u001b[K\r\r\n\u001b[7my\u001b[27m\u001b[K\r\r\n\u001b[7m# (le ✓ s'affiche, attendre 1 seconde)\u001b[27m\u001b[K\r\r\n\u001b[7m# Sortir avec Ctrl+D ou taper \"exit\"\u001b[27m\u001b[K\r\r\n\u001b[7mexit\u001b[27m\u001b[K"]
[1.236, "o", "\u001b[6A\u001b[21C\u001b[27m#\u001b[27m \u001b[27m(\u001b[27ma\u001b[27mt\u001b[27mt\u001b[27me\u001b[27mn\u001b[27md\u001b[27mr\u001b[27me\u001b[27m \u001b[27m1\u001b[27m \u001b[27ms\u001b[27me\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27md\u001b[27me\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mr\u001b[27mè\u001b[27ms\u001b[27m \u001b[27ml\u001b[27me\u001b[27m \u001b[27md\u001b[27mé\u001b[27mm\u001b[27ma\u001b[27mr\u001b[27mr\u001b[27ma\u001b[27mg\u001b[27me\u001b[27m \u001b[27md\u001b[27me\u001b[27m \u001b[27ml\u001b[27m'\u001b[27me\u001b[27mn\u001b[27mr\u001b[27me\u001b[27mg\u001b[27mi\u001b[27ms\u001b[27mt\u001b[27mr\u001b[27me\u001b[27mm\u001b[27me\u001b[27mn\u001b[27mt\u001b[27m)\u001b[1B\r\u001b[27md\u001b[27me\u001b[27ma\u001b[27md\u001b[27mp\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27m \u001b[27m3\u001b[27m0\u001b[27m0\u001b[27m0\u001b[1B\r\u001b[27m#\u001b[27m \u001b[27m(\u001b[27ml\u001b[27ma\u001b[27m \u001b[27mp\u001b[27mr\u001b[27mo\u001b[27mm\u001b[27mp\u001b[27mt\u001b[27m \u001b[27ma\u001b[27mp\u001b[27mp\u001b[27ma\u001b[27mr\u001b[27ma\u001b[27mî\u001b[27mt\u001b[27m,\u001b[27m \u001b[27mt\u001b[27ma\u001b[27mp\u001b[27me\u001b[27m \u001b[27m\"\u001b[27my\u001b[27m\"\u001b[27m \u001b[27me\u001b[27mt\u001b[27m \u001b[27mE\u001b[27mn\u001b[27mt\u001b[27me\u001b[27mr\u001b[27m)\u001b[1B\r\u001b[27my\u001b[1B\r\u001b[27m#\u001b[27m \u001b[27m(\u001b[27ml\u001b[27me\u001b[27m \u001b[27m✓\u001b[27m \u001b[27ms\u001b[27m'\u001b[27ma\u001b[27mf\u001b[27mf\u001b[27mi\u001b[27mc\u001b[27mh\u001b[27me\u001b[27m,\u001b[27m \u001b[27ma\u001b[27mt\u001b[27mt\u001b[27me\u001b[27mn\u001b[27md\u001b[27mr\u001b[27me\u001b[27m \u001b[27m1\u001b[27m \u001b[27ms\u001b[27me\u001b[27mc\u001b[27mo\u001b[27mn\u001b[27md\u001b[27me\u001b[27m)\u001b[1B\r\u001b[27m#\u001b[27m \u001b[27mS\u001b[27mo\u001b[27mr\u001b[27mt\u001b[27mi\u001b[27mr\u001b[27m \u001b[27ma\u001b"]
